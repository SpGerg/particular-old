unsyntax {
	prototype function printf(content: character*, ...): integer
	prototype function printn(content: integer, ...): integer
	prototype function printc(content: character, ...): integer
	prototype function strlen(content: const character*): integer
	prototype function malloc(size: integer): pointer
}

function print(content: any): static void {
	if content is integer {
		printn(content :: integer)
	}
	else {
		if content is character* {
			printf(content :: character*)
		}
		else {
			if content is character {
				printc(content :: character)
			}
		}
	}
}

static function fib(n: integer): static integer {
    if n <= 1 {
        return n
    }

    return fib(n - 1) + fib(n - 2)
}

static function list_typedata_name(T: static type): static word {
	return !<__list_object_ word(T)> 
}

type list generator(T: static type) {
	: @{ 
		~name: static word = list_typedata_name(T)
		typedata !~name(entities: !T*, count: integer)
    } !~name {
		function print(self): void {
			print(self.entities[0])
		}
	}
}

function create provider(T: static type) {
	(capacity: integer): list(T) {
		return !list_typedata_name(T)(!none) :: list(T)
	}
}

function main(): integer {
	list: list(>character) = create(>character)(8)
	list2: list(>character) = create(>character)(16)

	return 0
}